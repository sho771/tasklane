{
  "name": "taskkanri-desktop",
  "version": "0.1.0",
  "description": "Desktop task manager with Gantt chart built with Electron + React",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev-url=http://127.0.0.1:5173\"",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@mdxeditor/editor": "^3.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "vite": "^7.3.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.taskkanri.desktop",
    "productName": "Taskkanri Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "Taskkanri-${version}-${arch}.${ext}"
    }
  }
}
